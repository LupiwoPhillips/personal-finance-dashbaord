# Copy this file to .env and fill in your Supabase project credentials.
# Find these in your Supabase project: Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: currency exchange rate API (used by multi-currency support)
# Get a free key at https://www.exchangerate-api.com/ (or leave blank to use static fallback rates)
VITE_EXCHANGE_RATE_API_KEY=
